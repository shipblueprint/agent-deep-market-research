# LLM Provider: "ollama_cloud" or "openai"
LLM_PROVIDER=ollama_cloud

# Ollama Cloud (get key at https://ollama.com/settings/keys)
OLLAMA_API_KEY=your-ollama-cloud-api-key

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key

# Exa Search API (get key at https://exa.ai)
EXA_API_KEY=your-exa-api-key

# Jina Reader API (optional - free tier works without key)
# Get yours at: https://jina.ai/
JINA_API_KEY=